device PIC18F47Q10
hwtool sim
program E:\hamcode\PicAmpControl\_build\q10_probe\q10_firmware.elf
Stepi 200000
print g_state
print g_startup_inhibit
print g_ptt_active
print g_sequence_stage
print g_tick_count
print INTCON
print T2CON
print PR2
print OSCCON1
print T2CLK
Stepi 200000
print g_state
print g_startup_inhibit
print g_fault_latched
print TRISA
print TRISB
print TRISC
print TRISD
print ANSELA
print ANSELB
print ANSELC
print ANSELD
Stepi 200000
print g_state
print g_band_established
print g_fc_status.band_locked
print T1CKIPPS
print PORTD
print PORTC
quit
