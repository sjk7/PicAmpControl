# clangd configuration for the XC8 PIC build. Committed, and deliberately free of
# machine-specific paths so it works unchanged on macOS and Windows.
#
# Nothing absolute is needed here:
#   - CompilationDatabase is relative to this file, and the compile database CMake
#     generates already carries the compiler path (and -mdfp pack path) of the
#     machine it was configured on.
#   - clangd asks that compiler for its system includes ("System includes
#     extractor: successfully executed xc8-cc"), so the XC8 and DFP include
#     directories are discovered automatically on either OS.
#   - The firmware's own headers are included with relative paths
#     ("../include/..."), so they need no -I either.
# Verified with clangd 19.1.7: --check on firmware/src/main.c reports 0 errors
# with no -I or -mdfp lines present. Do not re-add per-machine paths.
CompileFlags:
  CompilationDatabase: "_build/My_Pic_Project/release"
  # Do NOT add `-mcpu=...` here. The compile database already carries the device (from
  # device.cmake), and hand-adding it produced a Problems-panel error of its own:
  #   Unsupported argument '18F47Q10' to option '-mcpu='
  # because clang has no such CPU. `-mdfp=<pack>` stays in the database, because clangd needs the
  # pack to resolve <xc.h>; the fix for a stale pack path is a fresh configure of
  # `_build/My_Pic_Project/release`, not a flag edit here.
  Add:
    - "-D__XC8"
    - "-D__PICC18__"
    - "-D_18F47Q10"
    - "-D__18F47Q10__"
    - "-D__XC8_VERSION=4000"
    - "-D__DEBUG=1"
    - "-DXPRJ_default=default"
    # XC8's C99 library header (c99/bits/alltypes.h) uses its 24-bit types `__int24`/`__uint24`,
    # which clang has never heard of, so including it aborts the parse with "unknown type name
    # '__int24'" and swamps everything after it. `__bit` is XC8's bit type, and `__far`/`__at(...)`
    # are storage qualifiers clang does not have. Mapping them to host equivalents is cosmetically
    # wrong (24 vs 64 bits) and entirely harmless for indexing. clangd-ONLY on purpose: they are NOT
    # in the CMake options, because redefining a compiler type for the real XC8 build would be a
    # genuine risk to the firmware. Enumerated with a grep over both include trees; verified
    # 2026-09-23 that these are the only ones the headers use.
    - "-D__int24=long"
    - "-D__uint24=unsigned long"
    - "-D__bit=unsigned char"
    - "-D__far="
    - "-D__at(x)="
    - "-Wno-unknown-pragmas"
    - "-Wno-unused-variable"
    # XC8's `__interrupt` attribute, and the offsetof cast clang warns about because XC8's offsetof
    # is not clang's on a 64-bit host. Both clangd-only; neither belongs in the CMake options.
    # `__interrupt` is a FUNCTION-LIKE keyword (`void __interrupt() isr(void)`), so it has to be
    # matched variadically - an object-like `-D__interrupt=` leaves `void () isr(void)` behind and
    # clang reports "expected identifier or '('".
    - "-D__interrupt(...)="
    - "-Wno-pointer-to-int-cast"
  Remove:
    # XC8 driver flags that clang has no equivalent for, and which clangd therefore reports:
    #   Unsupported argument '18F47Q10' to option '-mcpu='
    #   Unknown argument: '-mdfp=/Applications/microchip/.../xc8'
    #
    # `-mcpu=` is redundant: the target part reaches clangd through the __18F47Q10__ define. And
    # `-mdfp=` can be removed NOW, although removing it before 2026-09-23 made everything worse -
    # that was when clangd had no other way to find <xc.h>. With the pack and compiler include
    # directories in the compile database (see user.cmake) the flag is no longer load-bearing for
    # clangd, and removing it drops the last "Unknown argument" diagnostic. The BUILD still needs
    # -mdfp; it comes from the database and never passes through this file.
    - "-mcpu=*"
    - "-mdfp=*"
    - "-msummary=*"
    - "-maddrqual=*"
    - "-mwarn=*"
    - "-ginhx32"
    - "-mno-*"
    - "-mstack=*"
    - "-fno-short-double"
    - "-fno-short-float"

