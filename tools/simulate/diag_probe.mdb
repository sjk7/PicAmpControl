device PIC18F47Q10
hwtool sim
program E:/hamcode/PicAmpControl/out/My_Pic_Project_18F47Q10/default.elf
write pin RA0 0v
write pin RA1 0v
write pin RA2 0v
write pin RA3 0v
write pin RA5 2.5v
write pin RB1 0v
write pin RB2 0v
write pin RB3 0v
write pin RB4 0v
write pin RC2 5v
write pin RB0 5v
write pin RB6 5v
Stepi 2400000
print g_startup_inhibit
write /r 0x0DA 0x01
Stepi 500000
print g_diag_running
print g_diag_done
print g_diag_result
print g_diag_phase
print g_diag_index
print g_diag_sub
quit
