        "-DCMAKE_TOOLCHAIN_FILE=E:/hamcode/PicAmpControl/cmake/My_Pic_Project/default/.generated/toolchain.cmake",
        "-DCMAKE_USER_MAKE_RULES_OVERRIDE=E:/hamcode/PicAmpControl/cmake/My_Pic_Project/default/.generated/overrides.cmake",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "&&",
        "cmake",
        "--build",
        "E:/hamcode/PicAmpControl/_build/My_Pic_Project/release",
        "--verbose"
