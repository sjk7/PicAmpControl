{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PicAmpControl (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/cmake/My_Pic_Project/default",
        "-B",
        "${workspaceFolder}/_build/My_Pic_Project/debug",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/My_Pic_Project/default/.generated/toolchain.cmake",
        "-DCMAKE_USER_MAKE_RULES_OVERRIDE=${workspaceFolder}/cmake/My_Pic_Project/default/.generated/overrides.cmake",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "&&",
        "cmake",
        "--build",
        "${workspaceFolder}/_build/My_Pic_Project/debug",
        "--verbose",
        "-j4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build PicAmpControl (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/cmake/My_Pic_Project/default",
        "-B",
        "${workspaceFolder}/_build/My_Pic_Project/release",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/My_Pic_Project/default/.generated/toolchain.cmake",
        "-DCMAKE_USER_MAKE_RULES_OVERRIDE=${workspaceFolder}/cmake/My_Pic_Project/default/.generated/overrides.cmake",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "&&",
        "cmake",
        "--build",
        "${workspaceFolder}/_build/My_Pic_Project/release",
        "--verbose",
        "-j4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
