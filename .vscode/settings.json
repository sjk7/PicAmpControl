{
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/_build/My_Pic_Project/release",
        // No --query-driver here: clangd's system-include extraction cannot work with XC8. It runs
        // the driver as `xc8-cc -E -v -x c -`, and XC8 refuses that with "(2042) no target device
        // specified" because clangd does not forward the -mcpu=/-mdfp= flags it does not
        // understand. The include paths come from the compile database instead (user.cmake adds
        // them), which is also what keeps them machine-resolved. Added then removed 2026-09-23.
        "--header-insertion=never"
    ],
    "mplab.clangd.compileCommandsDir": "${workspaceFolder}/_build/My_Pic_Project/release",
    "mplab.clangd.arguments": [
        "--header-insertion=never"
    ],
    // Keep the simulator's benign per-reset warnings (W0106-SIM for TMR1/TMR3/TMR5, whose
    // clock-source mux the model does not implement) out of the debug console by giving the
    // MPLAB message channels their own Output channels. The firmware never configures those
    // timers, so the warning means nothing here - see Ai-Notes.txt. The adapter exposes no
    // true suppression option, so this is the output-routing lever, not a filter.
    "mplab.coreDebugger.categorizeOutputEvents": true,
    // Deliberately NOT pointing C_Cpp at compile_commands.json. When that property is set, the C/C++
    // extension IGNORES includePath/defines and parses the XC8 command line instead - and
    // `-mdfp=<pack>` is an argument it does not understand, so it never learns where the device
    // headers live: <xc.h> is "not found" and every register (LATCbits, ADCON1, ADPCH, NVMCON1bits)
    // comes back undeclared, which buries the two real diagnostics under ~20 cascading ones.
    // c_cpp_properties.json carries the per-OS pack include path (Mac-XC8 / Windows-XC8); that is
    // what resolves the headers. Fixed 2026-09-23.
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/firmware/include"
    ],
    "C_Cpp.default.defines": [
        "__18F47Q10__",
        "_18F47Q10",
        "__XC8",
        "__XC8_VERSION=4000",
        "__DEBUG=1",
        "XPRJ_default=default"
    ],
    "C_Cpp.default.cStandard": "c99",
    "cmake.generator": "Ninja",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,
    "cmake.sourceDirectory": "${workspaceFolder}/cmake/My_Pic_Project/default",
    "cmake.buildDirectory": "${workspaceFolder}/_build/My_Pic_Project/release",
    "memory-inspector.debugTypes": [
        "arm-debugger",
        "embedded-debug",
        "gdb",
        "gdbtarget",
        "mplab-core-da"
    ],
    "chat.tools.terminal.autoApprove": {
        "/^(python3?|py) tools/simulate/trace_ptt_sequence\\.py --suite$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}